+def _words_over(page: int, box) -> list[str]:
+    words = _SECOND.get(str(page), [])
+    mid = box.y + box.h / 2
+    hit = [w for w in words if w["y"] <= mid <= w["y"] + w["h"]
+           and min(w["x"] + w["w"], box.x + box.w) - max(w["x"], box.x) > 0.3 * min(w["w"], box.w)]
+    return [w["text"].replace("0-0-0", "O-O-O").replace("0-0", "O-O") for w in sorted(hit, key=lambda w: w["x"])]
+
+
+def _second_reading(tokens: list[Token]) -> list[Token]:
+    """SPIKE: give each move what a second reading saw at its place, and read
+    the moves a second reading finds inside a short run of score text."""
+    global _SECOND
+    import os, json
+    if _SECOND is None:
+        path = os.environ.get("RCE_SECOND_READING")
+        _SECOND = json.load(open(path)) if path else {}
+    if not _SECOND:
+        return tokens
+    out: list[Token] = []
+    for at, token in enumerate(tokens):
+        before = out[-1].kind if out else None
+        after = tokens[at + 1].kind if at + 1 < len(tokens) else None
+        if token.kind == "move" and token.bbox is not None:
+            found = _SAN.findall(" ".join(_words_over(token.page, token.bbox)))
+            if len(found) == 1:
+                token = dataclasses.replace(token, second=found[0])
+        elif (token.kind == "text" and token.bbox is not None and len(token.text.strip()) <= 12
+              and before in ("move", "move_number", "annotation") and after in ("move", "move_number")):
+            words = _words_over(token.page, token.bbox)
+            found = [m for m in _SAN.findall(" ".join(words)) if not re.fullmatch(r"[a-h][1-8]", m) or len(words) <= 3]
+            if found:
+                for san in found:
+                    out.append(dataclasses.replace(token, kind="move", text=san, second=san))
+                continue
+        out.append(token)
+    return out
 
 
